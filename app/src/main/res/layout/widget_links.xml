<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="5dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_links_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="LINKS"
            android:textColor="#8FA8FF"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <ImageView
            android:id="@+id/widget_links_open"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:contentDescription="Open Spectrum Notify"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <ImageView
            android:id="@+id/widget_links_edit"
            android:layout_width="32dp"
            android:layout_height="26dp"
            android:contentDescription="Edit links"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_edit"
            android:tint="#8FA8FF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_links_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
